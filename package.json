{
  "name": "health-tracker",
  "version": "1.0.0",
  "description": "Independent active-use health reminders with a local settings dashboard.",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "electron .",
    "pretest": "npm run build",
    "test": "npm run test:backend && npm run test:ui",
    "test:backend": "node --test tests/*.test.js",
    "test:ui": "vitest run",
    "preview:ui": "node scripts/preview.cjs",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.health.reminder",
    "productName": "Little Reset",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**",
      "renderer-dist/**",
      "README.md",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "fullcalendar": "^6.1.22",
    "lucide": "^0.468.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  }
}
